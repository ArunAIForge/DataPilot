# Copy to .env and fill ONE provider. Never commit .env.
# Supported: openrouter | groq | openai   (mock = offline demo, no key needed)
LLM_PROVIDER=groq

# Optional model override (name as the provider expects it)
# LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

LLM_TEMPERATURE=0.1
MAX_MESSAGES=20        # hard stop for the agent conversation (set 12 for the brief's strict limit)
EXECUTOR=local         # local (sandbox folder) | docker (needs Docker Desktop)
EXEC_TIMEOUT=60        # seconds per code run
